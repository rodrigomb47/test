    {
      "abs_x": [0, 1.01],
      "cubes": ["chest", "bust", "waist"],
      "faces": ["north"],
      "material": "cloth",
      "slot": "alt",
      "y": ["waist_y + (chest_y - waist_y) * hem", "chest_top - 0.5"]
    },
    {"cubes": ["upper_arm_*", "forearm_*"], "material": "cloth", "slot": "main"},
