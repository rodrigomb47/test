{
  "_comment": "A kimono-style top with real volume (style pass 2): bell sleeves of eight cloth panels around each forearm on the sleeve bone, flared outward and trimmed at the hem, a frill ring at each cuff, puffed upper sleeves, a crossed V collar painted in two layers (alt edged in trim), a standing back collar and crossed lapel slabs in front. The bell panels' inner faces (the lining, `south` in strand space) are painted two tones darker and the frill's inner faces take the lining too, so a sleeve seen end-on (an arm raised toward the camera) reads as a shadowed opening, not a lit ring.",
  "id": "outfit_top/kimono_wide",
  "category": "outfit_top",
  "slots": {"main": "primary", "alt": "secondary", "trim": "trim"},
  "params": {"sleeve": {"default": 1, "max": 1.5, "min": 0.5}},
  "occupies": ["torso", "sleeves"],
  "paint": [
    {"cubes": ["chest", "bust", "waist"], "material": "cloth", "slot": "main"},
    {"cubes": ["upper_arm_*", "forearm_*"], "material": "cloth", "slot": "main"},
    {
      "cubes": ["chest", "bust"],
      "faces": ["north"],
      "material": "cloth",
      "slot": "trim",
      "vee": ["chest_top - 4.25", 0.7]
    },
    {
      "cubes": ["chest", "bust"],
      "faces": ["north"],
      "material": "cloth",
      "slot": "alt",
      "vee": ["chest_top - 3.25", 0.7]
    },
    {"cubes": ["#bell*"], "faces": ["south"], "material": "cloth", "slot": "main", "tone": -2},
    {"cubes": ["#cuff_frill*"], "faces": ["south", "down"], "material": "cloth", "slot": "main", "tone": -2}
  ],
  "cubes": [
    {
      "name": "collar",
      "bone": "chest",
      "origin": ["-neck_w / 2 - 1", "chest_top - 0.25", -0.5],
      "size": ["neck_w + 2", 1.25, "chest_d / 2 + 0.75"],
      "slot": "trim"
    },
    {
      "name": "puff",
      "bone": "arm_r",
      "origin": ["-shoulder_x - arm_w / 2 - 0.6", "elbow_y + 1", "-arm_d / 2 - 0.6"],
      "size": ["arm_w + 1.2", "arm_top - elbow_y - 0.75", "arm_d + 1.2"],
      "mirror": true
    }
  ],
  "groups": [
    {
      "rotation": [0, 0, -22],
      "pivot": [-2.25, "chest_top", "-chest_d / 2"],
      "cubes": [
        {
          "name": "lapel_r",
          "bone": "chest",
          "origin": [-2.875, "chest_top - 5.5", "-chest_d / 2 - 0.45"],
          "size": [1.25, 5.5, 0.45],
          "slot": "trim",
          "fine": true
        }
      ]
    },
    {
      "rotation": [0, 0, 22],
      "pivot": [2.25, "chest_top", "-chest_d / 2"],
      "cubes": [
        {
          "name": "lapel_l",
          "bone": "chest",
          "origin": [1.625, "chest_top - 5.5", "-chest_d / 2 - 0.45"],
          "size": [1.25, 5.5, 0.45],
          "slot": "trim",
          "fine": true
        }
      ]
    }
  ],
  "strands": [
    {
      "name": "bell",
      "bone": "sleeve_r",
      "path": "arc",
      "center": ["-shoulder_x", 0],
      "radius": ["arm_w / 2 + 0.6", "arm_d / 2 + 0.6"],
      "y": "elbow_y + 1",
      "angles": [-180, 135],
      "count": 8,
      "width": "arm_w * 0.95 + 0.5",
      "depth": 0.75,
      "length": "(elbow_y - wrist_y) * (0.8 + 0.35 * sleeve) + 1.5",
      "flare": "10 + 10 * sleeve",
      "material": "cloth",
      "slot": "main",
      "fine": false,
      "mirror": true,
      "trim": {"slot": "trim", "edge": "bottom", "width": 1}
    },
    {
      "name": "cuff_frill",
      "bone": "sleeve_r",
      "path": "arc",
      "center": ["-shoulder_x", 0],
      "radius": ["arm_w / 2 + 0.9", "arm_d / 2 + 0.9"],
      "y": "wrist_y + 0.5",
      "angles": [-180, 144],
      "count": 10,
      "width": 1.6,
      "depth": 0.4,
      "length": 1.25,
      "flare": 45,
      "material": "cloth",
      "slot": "alt",
      "mirror": true,
      "tone": [0, -1]
    }
  ],
  "secondary": {"chain": ["sleeve_r", "sleeve_l"], "damping": 0.7, "stiffness": 0.5}
}
