{
  "_comment": "A hakama (style pass 2): pleated trouser-skirt panels from the waist to the shins (front and back sets with deeper pleats, alternately shaded), the legs painted in the same cloth underneath, a stiff back board and a trimmed waistband. drop = how far toward the ankle it reaches.",
  "id": "outfit_bottom/hakama",
  "category": "outfit_bottom",
  "slots": {"main": "accent", "trim": "trim"},
  "params": {"drop": {"default": 1.6, "max": 1.9, "min": 0.8}},
  "occupies": ["skirt", "legs_upper"],
  "paint": [{"cubes": ["hips", "thigh_*", "shin_*"], "material": "cloth", "slot": "main"}],
  "cubes": [
    {
      "name": "band",
      "bone": "skirt",
      "origin": ["-waist_w / 2 - 0.4", "waist_y - 0.25", "-waist_d / 2 - 0.4"],
      "size": ["waist_w + 0.8", 1.5, "waist_d + 0.8"],
      "slot": "trim"
    },
    {
      "name": "board",
      "bone": "skirt_b",
      "origin": ["-waist_w / 2 + 0.5", "waist_y - 0.75", "waist_d / 2 + 0.4"],
      "size": ["waist_w - 1", 2.5, 0.75],
      "slot": "main",
      "tone": 1
    }
  ],
  "strands": [
    {
      "name": "panel",
      "bone": "skirt",
      "path": "arc",
      "y": "waist_y + 0.25",
      "radius": ["hips_w / 2 + 0.15", "hips_d / 2 + 0.15"],
      "angles": [-180, 179.999],
      "count": 16,
      "width": "(hips_w + hips_d) * 0.24 + 0.6",
      "depth": 0.75,
      "length": "(waist_y - hip_y) + (hip_y - knee_y) + (knee_y - ankle_y) * (drop - 1) + 0.5",
      "flare": 9,
      "material": "cloth",
      "slot": "main",
      "fine": false,
      "tone": [0, -1],
      "layers": [0, 0.3],
      "bones_by_angle": {"skirt_f": [-45, 45], "skirt_l": [45, 135], "skirt_b": [135, 225], "skirt_r": [-135, -45]}
    }
  ]
