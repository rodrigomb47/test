{
  "_comment": "Socks and round shoes (style pass 2): socks painted on the shins with a folded cuff below the knee, round shoes as a shell 0.35 px round the foot with a sole, a toe cap and a strap.",
  "id": "legwear/socks_shoes",
  "category": "legwear",
  "slots": {"main": "secondary", "alt": "leather", "trim": "trim"},
  "params": {"sock": {"default": 0.75, "max": 1.2, "min": 0.2}},
  "occupies": ["legs_lower", "feet"],
  "paint": [{"cubes": ["shin_*"], "y": [0, "ankle_y + (knee_y - ankle_y) * sock"], "material": "cloth", "slot": "main"}],
  "cubes": [
    {
      "name": "cuff",
      "bone": "shin_r",
      "origin": ["-hip_x - leg_w / 2 - 0.3", "ankle_y + (knee_y - ankle_y) * sock - 1", "-leg_d / 2 - 0.3"],
      "size": ["leg_w + 0.3 + max(0.05, min(0.3, hip_x - leg_w / 2 - 0.05))", 1.25, "leg_d + 0.6"],
      "slot": "main",
      "mirror": true
    },
    {
      "name": "shoe",
      "bone": "foot_r",
      "origin": ["-hip_x - leg_w / 2 - 0.35", 0, "-leg_d / 2 - toe - 0.6"],
      "size": ["leg_w + 0.35 + max(0.05, min(0.35, hip_x - leg_w / 2 - 0.05))", "ankle_y + 0.35", "leg_d + toe + 0.95"],
      "slot": "alt",
      "material": "lacquer",
      "mirror": true,
      "trim": {"slot": "trim", "edge": "top", "width": 1}
    },
    {
      "name": "sole",
      "bone": "foot_r",
      "origin": ["-hip_x - leg_w / 2 - 0.4", 0, "-leg_d / 2 - toe - 0.65"],
      "size": ["leg_w + 0.4 + max(0.05, min(0.4, hip_x - leg_w / 2 - 0.05))", 0.5, "leg_d + toe + 1.05"],
      "slot": "alt",
      "material": "leather",
      "tone": -2,
      "mirror": true,
      "fine": true
    }
  ]
}
