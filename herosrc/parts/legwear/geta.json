{
  "_comment": "Split-toe socks and wooden clogs (G6b, tabi and geta): the feet and the shins up to `sock` painted white (alt), a thick wooden sole round the foot with its two teeth painted dark on the sides (the sole cannot go below the ground, so the teeth are read from the paint), and a thong strap in the trim colour. Shells stop short of the centre line.",
  "id": "legwear/geta",
  "category": "legwear",
  "slots": {
    "main": "leather",
    "alt": "secondary",
    "trim": "primary"
  },
  "params": {
    "sock": {"default": 0.35, "max": 0.7, "min": 0.15}
  },
  "occupies": ["legs_lower", "feet"],
  "paint": [
    {"cubes": ["foot_*"], "material": "cloth", "slot": "alt"},
    {
      "cubes": ["shin_*"],
      "y": [0, "ankle_y + (knee_y - ankle_y) * sock"],
      "material": "cloth",
      "slot": "alt"
    },
    {
      "cubes": ["#sole*"],
      "faces": ["east", "west"],
      "y": [0, 0.5],
      "z": ["-leg_d / 2 - toe + 1.0", "leg_d / 2 - 1.0"],
      "material": "wood",
      "slot": "main",
      "tone": -2
    },
    {
      "cubes": ["#sole*"],
      "faces": ["north", "south"],
      "y": [0, 0.5],
      "material": "wood",
      "slot": "main",
      "tone": -2
    }
  ],
  "cubes": [
    {
      "name": "sole",
      "bone": "foot_r",
      "origin": ["-hip_x - leg_w / 2 - 0.35", 0, "-leg_d / 2 - toe - 0.45"],
      "size": ["leg_w + 0.35 + max(0.05, min(0.35, hip_x - leg_w / 2 - 0.05))", 1.0, "leg_d + toe + 0.45 + 0.35"],
      "mirror": true,
      "material": "wood"
    },
    {
      "name": "strap",
      "bone": "foot_r",
      "origin": ["-hip_x - leg_w / 2 - 0.1", 0.9, "-leg_d / 2 - toe + 0.65"],
      "size": ["leg_w + 0.1 + max(0.05, min(0.1, hip_x - leg_w / 2 - 0.05))", 0.5, 0.75],
      "slot": "trim",
      "fine": true,
      "mirror": true
    },
    {
      "name": "thong",
      "bone": "foot_r",
      "origin": ["-hip_x - 0.25", 0.9, "-leg_d / 2 - toe - 0.3"],
      "size": [0.5, 0.6, 1.4],
      "slot": "trim",
      "fine": true,
      "mirror": true
    }
  ]
}
