    {"name": "waist", "bone": "waist", "origin": ["-waist_w / 2", 15, "-waist_d / 2"], "size": ["waist_w", 3, "waist_d"],
     "slot": "base_top", "material": "cloth"},
    {"name": "hips", "bone": "body", "origin": ["-hips_w / 2", 13, "-hips_d / 2"], "size": ["hips_w", 2, "hips_d"],
     "slot": "base_bottom", "material": "cloth"},
    {"name": "upper_arm_r", "bone": "arm_r", "origin": ["-shoulder_x - arm_w / 2", 17, "-arm_d / 2"],
